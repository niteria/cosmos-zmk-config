Keep force-awake sensors running while USB power is present, even when ZMK is
idle. Reconcile on both activity and USB changes, on the system work queue used
by sensor initialization and motion reads. Early events skip unready devices;
initialization itself applies the current policy.

Applies to badjeff/zmk-pmw3610-driver at
5c5af40de4d8cdf55dc63c4c5907af1e52da6a95 (MIT).

--- a/src/pmw3610.c
+++ b/src/pmw3610.c
@@ -11,7 +11,12 @@
 #include <zephyr/input/input.h>
 #include <zephyr/pm/device.h>
 #include <zmk/keymap.h>
+#include <zmk/activity.h>
 #include <zmk/events/activity_state_changed.h>
+#if IS_ENABLED(CONFIG_ZMK_USB)
+#include <zmk/events/usb_conn_state_changed.h>
+#include <zmk/usb.h>
+#endif
 #include "pmw3610.h"

 #include <zephyr/logging/log.h>
@@ -251,6 +256,14 @@
     return err;
 }

+static bool pmw3610_should_force_awake(void) {
+    bool enabled = zmk_activity_get_state() == ZMK_ACTIVITY_ACTIVE;
+#if IS_ENABLED(CONFIG_ZMK_USB)
+    enabled = enabled || zmk_usb_is_powered();
+#endif
+    return enabled;
+}
+
 static int pmw3610_set_performance(const struct device *dev, bool enabled) {
     const struct pixart_config *config = dev->config;
     int err = 0;
@@ -354,7 +367,7 @@
     }

     if (!err) {
-        err = pmw3610_set_performance(dev, true);
+        err = pmw3610_set_performance(dev, pmw3610_should_force_awake());
     }

     if (!err) {
@@ -693,21 +706,25 @@
     DT_FOREACH_STATUS_OKAY(pixart_pmw3610, GET_PMW3610_DEV)
 };

-static int on_activity_state(const zmk_event_t *eh) {
-    struct zmk_activity_state_changed *state_ev = as_zmk_activity_state_changed(eh);
-
-    if (!state_ev) {
-        LOG_WRN("NO EVENT, leaving early");
-        return 0;
-    }
-
-    bool enable = state_ev->state == ZMK_ACTIVITY_ACTIVE ? 1 : 0;
+static void pmw3610_update_performance(struct k_work *work) {
+    bool enable = pmw3610_should_force_awake();
     for (size_t i = 0; i < ARRAY_SIZE(pmw3610_devs); i++) {
-        pmw3610_set_performance(pmw3610_devs[i], enable);
+        struct pixart_data *data = pmw3610_devs[i]->data;
+        if (data->ready) {
+            pmw3610_set_performance(pmw3610_devs[i], enable);
+        }
     }
+}

-    return 0;
+K_WORK_DEFINE(pmw3610_performance_work, pmw3610_update_performance);
+
+static int on_power_state_changed(const zmk_event_t *eh) {
+    k_work_submit(&pmw3610_performance_work);
+    return ZMK_EV_EVENT_BUBBLE;
 }

-ZMK_LISTENER(zmk_pmw3610_idle_sleeper, on_activity_state);
+ZMK_LISTENER(zmk_pmw3610_idle_sleeper, on_power_state_changed);
 ZMK_SUBSCRIPTION(zmk_pmw3610_idle_sleeper, zmk_activity_state_changed);
+#if IS_ENABLED(CONFIG_ZMK_USB)
+ZMK_SUBSCRIPTION(zmk_pmw3610_idle_sleeper, zmk_usb_conn_state_changed);
+#endif
